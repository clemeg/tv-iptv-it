[Unit]
Description=Rebuild and publish the Italian IPTV playlists
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/tv-iptv-it
ExecStart=%h/tv-iptv-it/update.sh
# update.sh refuses to publish if fewer channels than the safety thresholds pass the live check
TimeoutStartSec=15min
